# Copy to .env and fill in. Never commit .env.

# PostgreSQL on the on-site server (or docker-compose in development).
DATABASE_URL=postgres://vms:change-me@localhost:5432/vms

# Web server
HOST=0.0.0.0
PORT=8080

# Site this server runs for (matches sites.code).
SITE_CODE=APM
# Docker only: create the site with this name on first start (real install, no demo data).
SITE_NAME=

# Session cookie signing key: a random string of at least 32 characters.
SESSION_SECRET=
# Hours a sign-in lasts.
SESSION_HOURS=14

# Optional shared token LPR cameras send in the x-vms-token header.
LPR_WEBHOOK_TOKEN=

# Built web app to serve in production: absolute path to apps/web/dist. Empty in development.
WEB_DIR=

# HTTPS (needed for the tablet camera and NFC): absolute paths to PEM files. Both or neither.
# Docker: HTTPS_CERT_FILE=/certs/cert.pem and HTTPS_KEY_FILE=/certs/key.pem
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# Where photos are stored on disk.
FILES_DIR=./files

# PDPA: days to keep IC photos and full IC numbers (decision Q5, default 90).
IC_PHOTO_RETENTION_DAYS=90

# Key for full IC numbers read from IC photos (decision Q2a): a random string of
# at least 32 characters. Keep it safe and do not change it (old numbers could
# no longer be read). Empty: only the last 4 digits are kept.
IC_ENCRYPTION_KEY=

# Integrations: "mock" until the real CWIS / SAP / LPR access is agreed.
SAP_ADAPTER=mock
CWIS_ADAPTER=mock
LPR_ADAPTER=mock

# Demo users created by `pnpm db:seed` (development only). Choose your own values.
SEED_DEMO_PIN=
SEED_DEMO_PASSWORD=

# Demo only (mock adapters + demo users): "on" wipes the day's activity on every
# start and builds a busy sample day; autoplay moves trucks every 20 seconds.
DEMO_DAY=off
DEMO_AUTOPLAY=off

# Tests: Postgres server where throwaway test databases are created.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
