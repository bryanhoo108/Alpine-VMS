# Copy to .env and fill in. Never commit .env.

# PostgreSQL on the on-site server (or docker-compose in development).
DATABASE_URL=postgres://vms:change-me@localhost:5432/vms

# Web server
HOST=0.0.0.0
PORT=8080

# Site this server runs for (matches sites.code).
SITE_CODE=APM

# Where photos are stored on disk.
FILES_DIR=./files

# PDPA: days to keep IC photos (decision Q5, default 90).
IC_PHOTO_RETENTION_DAYS=90

# Integrations: "mock" until the real CWIS / SAP / LPR access is agreed.
SAP_ADAPTER=mock
CWIS_ADAPTER=mock
LPR_ADAPTER=mock

# Demo users created by `pnpm db:seed` (development only). Choose your own values.
SEED_DEMO_PIN=
SEED_DEMO_PASSWORD=

# Tests: Postgres server where throwaway test databases are created.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
