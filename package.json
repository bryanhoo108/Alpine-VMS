{
  "name": "alpine-vms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vms/server dev",
    "dev:web": "pnpm --filter @vms/web dev",
    "build": "pnpm --filter @vms/web build",
    "start": "pnpm --filter @vms/server start",
    "db:migrate": "pnpm --filter @vms/server db:migrate",
    "db:seed": "pnpm --filter @vms/server db:seed",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @vms/web build && pnpm --filter @vms/web e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
